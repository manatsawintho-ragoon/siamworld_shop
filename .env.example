# MySQL Database
# When using Docker: MYSQL_HOST=mysql, MYSQL_USER=siamworld (matches Docker compose)
# When using bare metal: MYSQL_HOST=127.0.0.1, MYSQL_USER=your_db_user
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=siamworld
MYSQL_PASSWORD=Change_Me_Strong_Password_123!
MYSQL_DATABASE=siamworld
# Root password for the MySQL container. Keep it DIFFERENT from MYSQL_PASSWORD:
# the app connects with MYSQL_PASSWORD, so if that value ever leaks (a stack
# trace, a backup, a misconfigured dump) reusing it hands over root as well.
MYSQL_ROOT_PASSWORD=Change_Me_A_Different_Root_Password_456!

# Redis
# When using Docker: REDIS_HOST=redis
# When using bare metal: REDIS_HOST=127.0.0.1
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-key-min-32-chars
JWT_EXPIRES_IN=24h

# Encryption (for RCON passwords etc.) - REQUIRED, min 32 chars.
# MUST be different from JWT_SECRET (the backend refuses to start otherwise).
ENCRYPTION_KEY=change-this-to-a-different-secret-min-32-chars

# Backend
BACKEND_PORT=4000
NODE_ENV=production

# Frontend — REQUIRED: replace with your own HTTPS domain.
#
# Use https:// (and wss://), not http://. The session cookie is issued with the
# Secure flag whenever NODE_ENV=production, so a browser will refuse to store it
# over plain HTTP and logins will appear to succeed and then silently not stick.
# Serving the API over HTTP also puts every request — including the session
# cookie — on the wire in the clear.
# Example: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=https://shop.yourdomain.com/api
NEXT_PUBLIC_WS_URL=wss://shop.yourdomain.com

# CORS — IMPORTANT for production security
# Set to your frontend URL to prevent other websites from calling your API
# Example: CORS_ORIGIN=https://shop.yourdomain.com
# Multiple origins: CORS_ORIGIN=https://shop.yourdomain.com,https://admin.yourdomain.com
# WARNING: "*" allows ANY website to call your API. It is REJECTED at startup
# when NODE_ENV=production — set your real origin(s) before deploying.
CORS_ORIGIN=https://shop.yourdomain.com

# Rate Limiting (global: 300 req per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# EasySlip — Slip verification API (https://developer.easyslip.com)
EASYSLIP_API_KEY=your-easyslip-api-key-here
